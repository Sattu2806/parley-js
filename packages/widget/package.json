{
  "name": "parley-widget",
  "version": "1.0.1",
  "description": "Embeddable Parley chat widget: one script tag, shadow DOM, streaming answers with citations.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "author": "Satender Maurya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sattu2806/parley-js.git",
    "directory": "packages/widget"
  },
  "homepage": "https://github.com/Sattu2806/parley-js/tree/main/packages/widget#readme",
  "keywords": [
    "chatbot",
    "chat-widget",
    "ai-assistant",
    "rag",
    "website-chat"
  ],
  "main": "./dist/widget.js",
  "jsdelivr": "dist/widget.js",
  "unpkg": "dist/widget.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bugs": {
    "url": "https://github.com/Sattu2806/parley-js/issues"
  }
}
